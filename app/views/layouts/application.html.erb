<!DOCTYPE html>
<html lang="es">
  <head>
    <title><%= content_for(:title) || "Central de notificaciones" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Central de notificaciones">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Incluye todas las hojas de estilo de app/assets/stylesheets %>
    <%= stylesheet_link_tag :app %>
  </head>

  <body class="pagina-<%= content_for(:pagina) || "general" %>">
    <nav class="menu">
      <strong>Central de notificaciones</strong>
      <%= link_to "Inicio", root_path %>
      <%= link_to "Consola", consola_path %>
      <%= link_to "Catálogo", catalogo_path %>
      <%= link_to "Simulador", simulador_path %>
      <%= link_to "Historial", historial_path %>
      <%= link_to "Acerca", acerca_path %>
      <span class="externos">
        <%= link_to "Propuesta", Demo::Declaraciones::PROPUESTA_URL, target: "_blank", rel: "noopener" %>
        <%= link_to "Código", Demo::Declaraciones::CODIGO_URL, target: "_blank", rel: "noopener" %>
      </span>
    </nav>

    <main>
      <%= yield %>
    </main>
  </body>
</html>
