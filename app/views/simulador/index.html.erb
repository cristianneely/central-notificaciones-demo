<% content_for :title, "Simulador · Central de notificaciones" %>
<% content_for :pagina, "simulador" %>
<% definicion = @simulacion[:definicion] %>

<h1>Simulador</h1>
<p class="bajada">Una notificación se define una sola vez, con piezas: título, resumen, párrafo, destacado,
  lista, imagen y botón. Cada canal sabe dibujar cada pieza y, lo que no puede mostrar, lo degrada de una
  forma definida en el propio canal. Elige una notificación, cambia sus datos y mira cómo llegaría.</p>
<p class="aviso-simulador">El simulador usa <code>Contenido.rellenar</code> y el <code>adaptar</code> de cada
  canal, sin pasar por <code>send()</code>: no escribe nada en pendientes, claves ni auditoría, y no entrega
  nada. Slack, WhatsApp y SMS son canales simulados, fuera de la política de envío.</p>

<div class="simulador">
  <section class="tarjeta definicion-simulada">
    <form method="get" action="<%= simulador_path %>" class="formulario">
      <label>Notificación
        <select name="notificacion" id="notificacion-simulada">
          <% @notificaciones.each do |nombre| %>
            <option value="<%= nombre %>" <%= "selected" if nombre == definicion.nombre %>><%= nombre %></option>
          <% end %>
        </select>
      </label>
      <% definicion.datos.each do |dato| %>
        <label><code><%= dato %></code>
          <input type="text" name="datos[<%= dato %>]" value="<%= @simulacion[:datos][dato] %>">
        </label>
      <% end %>
      <button class="principal">Simular</button>
    </form>

    <h2>La definición, una sola</h2>
    <p class="nota">Así la escribe el equipo dueño. No dice por qué canal sale ni cómo se ve en cada uno.</p>
    <pre class="definicion-codigo"><%= @simulacion[:codigo] %></pre>
  </section>

  <section class="salida">
    <input type="checkbox" id="ver-crudo">
    <label for="ver-crudo" class="interruptor">Ver el mensaje crudo que recibiría cada proveedor</label>

    <div class="canales">
      <% @simulacion[:canales].each do |canal| %>
        <article class="tarjeta canal canal-<%= canal[:nombre] %>">
          <h2><%= SimuladorHelper::NOMBRES_CANALES.fetch(canal[:nombre]) %></h2>
          <%= render "simulador/#{canal[:nombre]}", mensaje: canal[:mensaje], notas: canal[:notas] %>

          <div class="notas">
            <% if canal[:notas].empty? %>
              <p>Sin degradación: dibuja todas las piezas.</p>
            <% else %>
              <ul><% canal[:notas].each do |nota| %><li><%= nota %></li><% end %></ul>
            <% end %>
          </div>
          <pre class="crudo"><%= mensaje_crudo(canal[:nombre], canal[:mensaje]) %></pre>
        </article>
      <% end %>
    </div>
  </section>
</div>

<script>
  // Al elegir otra notificación, se simula con sus datos de ejemplo.
  document.getElementById("notificacion-simulada").addEventListener("change", (evento) => {
    window.location = "<%= simulador_path %>?notificacion=" + encodeURIComponent(evento.target.value);
  });
</script>
