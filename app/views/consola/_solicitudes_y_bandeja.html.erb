<%# Últimas solicitudes de la empresa y bandeja del proveedor. Se refrescan. %>
<section class="tarjeta" id="solicitudes">
  <h2>2. Últimas solicitudes de <%= @empresa&.nombre %></h2>
  <p class="nota">Cada línea es una solicitud y una persona, con su recorrido completo en la auditoría.</p>
  <% @solicitudes.each do |solicitud| %>
    <div class="solicitud">
      <div class="encabezado">
        <span class="hora"><%= hora(solicitud.creado_en) %></span>
        <code><%= solicitud.notificacion %></code>
        <%= etiqueta_criticidad(solicitud.criticidad) %>
        <span><%= nombre_persona(solicitud.usuario_id) %></span>
        <span class="etiqueta <%= clase_estado(solicitud.estado) %>"><%= solicitud.estado %></span>
        <span class="id-solicitud">solicitud <%= solicitud.solicitud_id.first(8) %> ·
          origen <%= solicitud.recorrido.first.detalle["origen"] %></span>
      </div>
      <div class="recorrido">
        <% solicitud.recorrido.each_with_index do |fila, indice| %>
          <% if indice > 0 %><span class="flecha">→</span><% end %>
          <span class="paso" title="<%= hora(fila.creado_en) %> <%= detalle_como_texto(fila.detalle) %>"><%= evento_con_motivo(fila) %></span>
        <% end %>
      </div>
    </div>
  <% end %>
  <% if @solicitudes.empty? %><p class="vacio">Esta empresa todavía no tiene solicitudes.</p><% end %>
</section>

<section class="tarjeta" id="bandeja">
  <h2>3. Bandeja del proveedor simulado</h2>
  <p class="nota">Los últimos 20 correos que el proveedor aceptó, de todas las empresas. Ninguno salió
    de verdad.</p>
  <div class="correos">
    <% @bandeja.each do |correo| %>
      <div class="correo">
        <div class="para">Para: <%= correo.para %> <span class="id-solicitud"><%= correo.id_proveedor %></span></div>
        <div class="asunto"><%= correo.asunto %></div>
        <div class="cuerpo"><%= correo.cuerpo %></div>
        <% if correo.accion_texto.present? %>
          <div><span class="boton-correo"><%= correo.accion_texto %></span>
            <span class="link"><%= correo.accion_link %></span></div>
        <% end %>
      </div>
    <% end %>
  </div>
  <% if @bandeja.empty? %><p class="vacio">La bandeja está vacía.</p><% end %>
</section>
