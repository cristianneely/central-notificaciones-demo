<%# Las listas de la consola. Este pedazo se vuelve a pedir cada 2 segundos. %>
<section class="tarjeta estado-general">
  <span class="dato">Certificados emitidos en esta empresa: <%= @certificados %></span>
  <% if @proveedor_encendido %>
    <span class="dato estado-ok">Proveedor encendido</span>
  <% else %>
    <span class="dato estado-no">Proveedor apagado</span>
  <% end %>
  <span class="dato <%= "estado-no" if @canal.fallas_consecutivas > 0 %>">
    Canal email:
    <% if @canal.fallas_consecutivas.zero? %>
      sin fallas
    <% else %>
      <%= pluralize(@canal.fallas_consecutivas, "falla consecutiva", plural: "fallas consecutivas") %>,
      <% if @segundos_para_reintentar > 0 %>
        próximo intento en <%= @segundos_para_reintentar %> s
      <% else %>
        reintentando ahora
      <% end %>
    <% end %>
  </span>
</section>

<section class="tarjeta" id="pendientes">
  <h2>3. Pendientes <span class="cuenta"><%= @total_pendientes %></span></h2>
  <p class="nota">De todas las empresas, en el orden en que el despachador los tomaría: lo crítico
    primero y, después, lo más antiguo.</p>
  <table>
    <thead>
      <tr><th>Notificación</th><th>Empresa</th><th>Persona</th><th>Importancia</th><th>Antigüedad</th></tr>
    </thead>
    <tbody>
      <% @pendientes.each do |pendiente| %>
        <tr>
          <td><code><%= pendiente.notificacion %></code></td>
          <td><%= @nombres_empresas[pendiente.empresa_id] %></td>
          <td><%= nombre_persona(pendiente.usuario_id) %></td>
          <td><%= etiqueta_importancia(pendiente.importancia) %></td>
          <td><%= (Time.current - pendiente.creado_en).round %> s</td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <% if @pendientes.empty? %><p class="vacio">No hay pendientes.</p><% end %>
  <% if @total_pendientes > @pendientes.size %>
    <p class="nota">Se muestran los primeros <%= @pendientes.size %> de <%= @total_pendientes %>.</p>
  <% end %>
</section>

<section class="tarjeta" id="solicitudes">
  <h2>4. Últimas solicitudes de <%= @empresa&.nombre %></h2>
  <p class="nota">Cada línea es una solicitud y una persona, con su recorrido completo en la auditoría.</p>
  <% @solicitudes.each do |solicitud| %>
    <div class="solicitud">
      <div class="encabezado">
        <span class="hora"><%= hora(solicitud.creado_en) %></span>
        <code><%= solicitud.notificacion %></code>
        <%= etiqueta_importancia(solicitud.importancia) %>
        <span><%= nombre_persona(solicitud.usuario_id) %></span>
        <span class="etiqueta <%= clase_estado(solicitud.estado) %>"><%= solicitud.estado %></span>
        <span class="id-solicitud">solicitud <%= solicitud.solicitud_id.first(8) %> ·
          origen <%= solicitud.recorrido.first.detalle["origen"] %></span>
      </div>
      <div class="recorrido">
        <% solicitud.recorrido.each_with_index do |fila, indice| %>
          <% if indice > 0 %><span class="flecha">→</span><% end %>
          <span class="paso" title="<%= hora(fila.creado_en) %> <%= detalle_como_texto(fila.detalle) %>"><%= evento_con_motivo(fila) %></span>
        <% end %>
      </div>
    </div>
  <% end %>
  <% if @solicitudes.empty? %><p class="vacio">Esta empresa todavía no tiene solicitudes.</p><% end %>
</section>

<section class="tarjeta" id="bandeja">
  <h2>5. Bandeja del proveedor simulado</h2>
  <p class="nota">Los últimos 20 correos que el proveedor aceptó, de todas las empresas. Ninguno salió
    de verdad.</p>
  <div class="correos">
    <% @bandeja.each do |correo| %>
      <div class="correo">
        <div class="para">Para: <%= correo.para %> <span class="id-solicitud"><%= correo.id_proveedor %></span></div>
        <div class="asunto"><%= correo.asunto %></div>
        <div class="cuerpo"><%= correo.cuerpo %></div>
        <% if correo.accion_texto.present? %>
          <div><span class="boton-correo"><%= correo.accion_texto %></span>
            <span class="link"><%= correo.accion_link %></span></div>
        <% end %>
      </div>
    <% end %>
  </div>
  <% if @bandeja.empty? %><p class="vacio">La bandeja está vacía.</p><% end %>
</section>
